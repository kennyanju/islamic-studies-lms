{
  "name": "islamic-studies-lms",
  "version": "1.0.0",
  "description": "Lightweight LMS for Islamic Studies Course (Foundations, Purification, Seerah, Fiqh, Character)",
  "main": "server.js",
  "scripts": {
    "build": "node compile.js",
    "start": "node server.js",
    "dev": "node compile.js && node server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:smoke": "node compile.js && jest tests/smoke.test.js --forceExit",
    "smoke": "npm run test:smoke",
    "deploy": "node compile.js && wrangler deploy",
    "deploy:staging": "node compile.js && wrangler deploy --env staging",
    "deploy:prod": "node compile.js && wrangler deploy --env production",
    "worker:deploy": "node compile.js && wrangler deploy",
    "pages:deploy": "node compile.js && wrangler pages deploy public",
    "d1:migrate:local": "wrangler d1 migrations apply islamic-studies-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply islamic-studies-db --remote",
    "d1:backup:remote": "wrangler d1 export islamic-studies-db --remote --output ./data/backup-remote.sql",
    "d1:backup:local": "wrangler d1 export islamic-studies-db --local --output ./data/backup-local.sql"
  },
  "keywords": [
    "lms",
    "islamic-studies",
    "education",
    "interactive-quiz"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dompurify": "^3.4.13",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "jsdom": "^29.1.1",
    "marked": "^12.0.2",
    "morgan": "^1.11.0",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "wrangler": "^4.124.0"
  }
}
