/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Report-To: {"group":"csp-endpoint","max_age":86400,"endpoints":[{"url":"/api/telemetry/csp"}]}
  Reporting-Endpoints: csp-endpoint="/api/telemetry/csp"
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https: https://api.dicebear.com blob:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; report-uri /api/telemetry/csp; report-to csp-endpoint

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/modules_manifest.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/course_data.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/course_data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/icons/*
  Cache-Control: public, max-age=2592000, immutable

/*.js
  Cache-Control: public, max-age=300, must-revalidate

/*.css
  Cache-Control: public, max-age=300, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

