/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' cdn.jsdelivr.net cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com cdnjs.cloudflare.com; font-src 'self' fonts.gstatic.com cdnjs.cloudflare.com; img-src 'self' data: https: api.dicebear.com blob:; connect-src 'self' https:; report-uri /api/telemetry/csp

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/modules_manifest.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/course_data.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/course_data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icons/*
  Cache-Control: public, max-age=2592000, immutable

/*.js
  Cache-Control: public, max-age=604800

/*.css
  Cache-Control: public, max-age=604800

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

